{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helios.local/contracts/cli-introspect.schema.json",
  "title": "Helios CLI Introspect",
  "type": "object",
  "required": ["name", "version", "commands"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sideEffect"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sideEffect": { "enum": ["none", "read", "write"] },
          "dryRun": { "type": "boolean" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "enum": ["string", "number", "boolean", "json"] },
                "required": { "type": "boolean" },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "default": {}
              }
            }
          }
        }
      }
    }
  }
}
